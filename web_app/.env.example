# Same-origin, versioned API base. Do not use a localhost URL in feature code.
VITE_API_BASE_URL=/api/v1
# Human-readable local deployment label only; it is not a secret.
VITE_PUBLIC_APP_NAME=Tajik HTR Studio
# Development-only Vite proxy target; never read by feature code or shipped to production.
HTR_WEB_API_PROXY_TARGET=http://127.0.0.1:8000
