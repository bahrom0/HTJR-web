{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd new_front && bun install --frozen-lockfile",
  "buildCommand": "cd new_front && bun run build",
  "outputDirectory": "new_front/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{api_server/tests/**,annotation_app/**,android/**,android_app_instructions/**,docs/**,final_product/**,HTR v2 CER/**,kraken_sidecar/**,raw_dataset/**,web_app/**,web_app_instructions/**,.tmp/**,.docx_*_qa/**,**/*.pptx,**/*.docx}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
